MBOARD_HOST=127.0.0.1
MBOARD_PORT=8787
MBOARD_DATA_DIR=./data
MBOARD_PUBLIC_ORIGIN=http://127.0.0.1:8787
# Comma-separated extra panel origins. Each hostname serves the same panel.
# MBOARD_PANEL_ORIGINS=https://panel-b.example.com
# Set a distinct HTTP(S) origin to enable subscription-only Host routing.
# MBOARD_SUBSCRIPTION_ORIGIN=https://subscription.example.com
MBOARD_LOGIN_LIMIT=10
MBOARD_PEER_LOGIN_LIMIT=200
